[Unit]
Description=colorfan custom fan curve for the Colorful X17 Pro (Clevo DCHU EC via WMBB)
After=systemd-modules-load.service
Wants=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/local/bin/colorfan daemon
# hand the fans back to the EC firmware curve whenever we stop for any reason
ExecStopPost=-/usr/local/bin/colorfan auto
Restart=on-failure
RestartSec=5
Nice=-5

[Install]
WantedBy=multi-user.target
